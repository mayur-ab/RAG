VECTOR_DB_PATH="./my_chroma_db"
VECTOR_STORE_PROVIDER=chroma

# Local Ollama (default — embeddings, LLM, chunking via header-aware strategy)
EMBEDDING_PROVIDER=ollama
LLM_PROVIDER=ollama
RERANKER_PROVIDER=cross_encoder
CHUNKING_STRATEGY=header

OLLAMA_BASE_URL=
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.1:8b
# Or use baked-in 32K ctx: rag-llama (see scripts/create_ollama_rag_model.ps1)
OLLAMA_NUM_CTX=32768

# Context / retrieval budgets (optional overrides)
# DEFAULT_CONTEXT_TOKENS=4000
# MAX_CONTEXT_TOKENS=8000
# TOP_K_RETRIEVAL=10
# TOP_K_RERANK=5
# CHUNK_SIZE=800
# USER_MEMORY_MAX_CHARS=4000

# Hierarchical long-document generation (10–20 page reports)
ENABLE_HIERARCHICAL_GENERATION=true
# LONG_DOC_MIN_PAGES=3
# LONG_DOC_MIN_WORDS=1500
# LONG_DOC_MAX_SECTIONS=12

# Document auto-classification (hybrid LLM + clustering)
ENABLE_DOC_CLASSIFICATION=true

# Optional cloud LLM (uncomment to use instead of Ollama)
# LLM_PROVIDER=nvidia_nim
# NVIDIA_API_KEY=your_key_here

ENABLE_QUERY_REWRITING=true
MAX_CHAT_HISTORY_TURNS=5

MAX_QUERY_LENGTH=4000
MAX_QUERY_WARN_LENGTH=3600

# Evaluation (optional LLM-as-judge via Ollama)
EVAL_USE_LLM_JUDGE=false
# EVAL_JUDGE_MODEL=llama3.1:8b
