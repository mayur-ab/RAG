VECTOR_DB_PATH="./my_chroma_db"
VECTOR_STORE_PROVIDER=chroma

# Local Ollama (default — embeddings, LLM, chunking via header-aware strategy)
EMBEDDING_PROVIDER=ollama
LLM_PROVIDER=ollama
RERANKER_PROVIDER=cross_encoder
CHUNKING_STRATEGY=header

OLLAMA_BASE_URL=
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.1:8b

# Optional cloud LLM (uncomment to use instead of Ollama)
# LLM_PROVIDER=nvidia_nim
# NVIDIA_API_KEY=your_key_here

ENABLE_QUERY_REWRITING=true
MAX_CHAT_HISTORY_TURNS=5

RERANKER_PROVIDER=identity

MAX_QUERY_LENGTH=4000
MAX_QUERY_WARN_LENGTH=3600

# Evaluation (optional LLM-as-judge via Ollama)
EVAL_USE_LLM_JUDGE=false
# EVAL_JUDGE_MODEL=llama3.1:8b
